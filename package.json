{
  "name": "next-better-auth",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "prepare": "husky",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write --check \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  },
  "packageManager": "pnpm@10.15.0",
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "prettier --check --write ."
    ]
  },
  "engines": {
    "node": ">=20"
  }
